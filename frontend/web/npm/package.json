{
  "name": "@tiqian/prose",
  "version": "0.1.0-alpha.5",
  "description": "Progressively enhance Chinese prose with Tiqian's CJK paragraph layout engine.",
  "keywords": [
    "cjk",
    "chinese",
    "typography",
    "prose",
    "layout",
    "web-component",
    "kotlin-js"
  ],
  "homepage": "https://github.com/tiqian-cjk/tiqian#readme",
  "bugs": {
    "url": "https://github.com/tiqian-cjk/tiqian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "frontend/web/npm"
  },
  "license": "MPL-2.0",
  "type": "module",
  "main": "./api.js",
  "module": "./api.js",
  "types": "./api.d.ts",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -b",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs tests/*.test.js",
    "verify:package": "node ./scripts/verify-package.mjs",
    "preverify:package": "npm run build",
    "verify:release": "npm run prepack && node ./scripts/verify-release.mjs",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "prepack": "npm test && npm run verify:package"
  },
  "files": [
    "LICENSE",
    "README.md",
    "api.d.ts",
    "api.js",
    "auto.d.ts",
    "auto.js",
    "element.d.ts",
    "element.js",
    "prepared-dom.d.ts",
    "prepared-dom.js",
    "snapshot-client.d.ts",
    "snapshot-client.js"
  ],
  "exports": {
    ".": {
      "types": "./api.d.ts",
      "default": "./api.js"
    },
    "./auto": {
      "types": "./auto.d.ts",
      "default": "./auto.js"
    },
    "./element": {
      "types": "./element.d.ts",
      "default": "./element.js"
    },
    "./snapshot-client": {
      "types": "./snapshot-client.d.ts",
      "default": "./snapshot-client.js"
    },
    "./prepared-dom": {
      "types": "./prepared-dom.d.ts",
      "default": "./prepared-dom.js"
    }
  },
  "dependencies": {
    "@tiqian/core": "0.1.0-alpha.5"
  },
  "sideEffects": [
    "./api.js",
    "./auto.js",
    "./element.js",
    "./prepared-dom.js",
    "./styles.css"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
