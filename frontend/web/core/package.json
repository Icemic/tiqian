{
  "name": "@tiqian/core",
  "version": "0.1.0-alpha.5",
  "description": "Core paragraph layout engine, snapshot tables, and runtime bindings for Tiqian.",
  "keywords": [
    "cjk",
    "chinese",
    "typography",
    "prose",
    "layout",
    "kotlin-js"
  ],
  "homepage": "https://github.com/tiqian-cjk/tiqian#readme",
  "bugs": {
    "url": "https://github.com/tiqian-cjk/tiqian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "frontend/web/core"
  },
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "verify:package": "node ./scripts/verify-package.ts",
    "preverify:package": "npm run build"
  },
  "files": [
    "LICENSE",
    "README.md",
    "*.d.ts",
    "core/",
    "core/engine/layout-worker.js",
    "core/engine/web-worker/worker-channel.js",
    "core/measurement/browser-font-replay.js",
    "core/sampler/snapshot/snapshot-schema.js",
    "core/sampler/snapshot/snapshot-manifest.js",
    "core/sampler/snapshot/snapshot-table-binary.js",
    "core/sampler/snapshot/snapshot-tables.js",
    "core/sampler/snapshot/table-binary-writer.js",
    "core/measurement/browser-fonts.js",
    "core/sampler/font-face-boundaries.js",
    "core/sampler/snapshot/precomputed.js",
    "core/sampler/snapshot/snapshot-source.js",
    "core/engine/coordination/viewport-anchor.js",
    "styles.css"
  ],
  "exports": {
    "./core/*": "./core/*",
    "./snapshot-schema": {
      "default": "./core/sampler/snapshot/snapshot-schema.js"
    },
    "./snapshot-schema.js": {
      "default": "./core/sampler/snapshot/snapshot-schema.js"
    },
    "./snapshot-manifest": {
      "default": "./core/sampler/snapshot/snapshot-manifest.js"
    },
    "./snapshot-manifest.js": {
      "default": "./core/sampler/snapshot/snapshot-manifest.js"
    },
    "./snapshot-tables": {
      "default": "./core/sampler/snapshot/snapshot-tables.js"
    },
    "./snapshot-tables.js": {
      "default": "./core/sampler/snapshot/snapshot-tables.js"
    },
    "./snapshot-table-binary": {
      "default": "./core/sampler/snapshot/snapshot-table-binary.js"
    },
    "./snapshot-table-binary.js": {
      "default": "./core/sampler/snapshot/snapshot-table-binary.js"
    },
    "./table-binary-writer": {
      "default": "./core/sampler/snapshot/table-binary-writer.js"
    },
    "./browser-font-replay": {
      "default": "./core/measurement/browser-font-replay.js"
    },
    "./browser-font-replay.js": {
      "default": "./core/measurement/browser-font-replay.js"
    },
    "./layout-worker": {
      "default": "./core/engine/layout-worker.js"
    },
    "./layout-worker.js": {
      "default": "./core/engine/layout-worker.js"
    },
    "./browser-fonts": {
      "default": "./core/measurement/browser-fonts.js"
    },
    "./browser-fonts.js": {
      "default": "./core/measurement/browser-fonts.js"
    },
    "./viewport-anchor": {
      "default": "./core/engine/coordination/viewport-anchor.js"
    },
    "./viewport-anchor.js": {
      "default": "./core/engine/coordination/viewport-anchor.js"
    },
    "./snapshot-source": {
      "default": "./core/sampler/snapshot/snapshot-source.js"
    },
    "./snapshot-source.js": {
      "default": "./core/sampler/snapshot/snapshot-source.js"
    },
    "./worker-layout": {
      "default": "./core/engine/web-worker/worker-channel.js"
    },
    "./worker-layout.js": {
      "default": "./core/engine/web-worker/worker-channel.js"
    },
    "./precomputed": {
      "default": "./core/sampler/snapshot/precomputed.js"
    },
    "./precomputed.js": {
      "default": "./core/sampler/snapshot/precomputed.js"
    },
    "./font-face-boundaries": {
      "default": "./core/sampler/font-face-boundaries.js"
    },
    "./font-face-boundaries.js": {
      "default": "./core/sampler/font-face-boundaries.js"
    },
    "./styles.css": {
      "default": "./styles.css"
    }
  },
  "dependencies": {
    "@tiqian/ffi": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.9.3"
  }
}
