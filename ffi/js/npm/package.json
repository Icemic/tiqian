{
  "name": "@tiqian/ffi",
  "version": "0.1.0-alpha.1",
  "description": "Kotlin/JS engine face for Tiqian paragraph precompute.",
  "keywords": [
    "cjk",
    "chinese",
    "typography",
    "kotlin-js"
  ],
  "homepage": "https://github.com/tiqian-cjk/tiqian#readme",
  "bugs": {
    "url": "https://github.com/tiqian-cjk/tiqian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "ffi/js/npm"
  },
  "license": "MPL-2.0",
  "type": "module",
  "main": "./runtime/Tiqian-tiqian-ffi-js.mjs",
  "types": "./runtime/Tiqian-tiqian-ffi-js.d.mts",
  "exports": {
    ".": {
      "types": "./runtime/Tiqian-tiqian-ffi-js.d.mts",
      "default": "./runtime/Tiqian-tiqian-ffi-js.mjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build:runtime": "node ./build-runtime.mjs",
    "test": "node --test *.test.mjs",
    "verify:package": "node ./verify-package.mjs",
    "verify:release": "npm run prepack && node ./verify-release.mjs",
    "release:prepare": "node ./prepare-release.mjs",
    "prepack": "npm run build:runtime && npm test && npm run verify:package"
  },
  "files": [
    "LICENSE",
    "README.md",
    "runtime/"
  ]
}
